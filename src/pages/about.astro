---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Me - Zonix" description="Learn more about Ahmed Farhan and the Zonix blog project.">
  <main class="container mx-auto px-4 py-8 max-w-3xl">
    <h1 class="text-4xl font-extrabold mb-6 tracking-tight">About Me</h1>
    
    <section class="space-y-4 text-lg leading-relaxed text-gray-700 dark:text-gray-300">
      <p>
        Welcome to <strong>Zonix</strong> — my personal digital workspace and engineering journal.
      </p>
      
      <p>
        I'm <strong>Ahmed Farhan</strong>, a Mechanical Engineering student with a deep passion for software development, systems engineering, and technical problem-solving.
      </p>

      <p>
        This blog serves as a platform to document my journey, share insights on custom algorithms, low-level programming concepts, web architecture, and explore modern technology tools.
      </p>

      <div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-800">
        <h2 class="text-2xl font-bold mb-3 text-gray-900 dark:text-white">Core Focus Areas</h2>
        <ul class="list-disc list-inside space-y-2">
          <li><strong>Software & Algorithms:</strong> C++ implementations, data structures, and logic design.</li>
          <li><strong>Engineering & Design:</strong> Blending mechanical principles with digital solution architectures.</li>
          <li><strong>Technical Writing:</strong> In-depth articles, tutorials, and practical dev notes.</li>
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>